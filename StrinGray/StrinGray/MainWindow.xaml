                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CelulaTabela}" Text="30/04/2024"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource CelulaTabela}" Text="Sofia Martins"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource CelulaTabela}" Text="14/05/2024"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource CelulaTabela}" Text="Hidroginástica"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource CelulaTabela}" Text="Abr/2024"/>
                                        <TextBlock Grid.Column="5" Style="{StaticResource CelulaTabela}" Text="Mensalidade"/>
                                        <TextBlock Grid.Column="6" Style="{StaticResource CelulaTabela}" Text="PIX"/>
                                        <TextBlock Grid.Column="7" Style="{StaticResource CelulaTabela}" Text="180,00"/>
                                        <Border Grid.Column="8" Width="38" Height="20" Background="#E8F7ED" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Pago" Foreground="#26954A" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Style="{StaticResource BotaoEditar}" Content="✎" ToolTip="Editar"/>
                                            <Button Style="{StaticResource BotaoExcluir}" Content="🗑" Margin="5,0,0,0" ToolTip="Excluir"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Registro 10 -->
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1.05*"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource CelulaTabela}" Text="28/04/2024"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource CelulaTabela}" Text="Rafael Santos"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CelulaTabela}" Text="08/06/2024"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource CelulaTabela}" Text="Natação Competição"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource CelulaTabela}" Text="Abr/2024"/>
                                    <TextBlock Grid.Column="5" Style="{StaticResource CelulaTabela}" Text="Mensalidade"/>
                                    <TextBlock Grid.Column="6" Style="{StaticResource CelulaTabela}" Text="Boleto Bancário"/>
                                    <TextBlock Grid.Column="7" Style="{StaticResource CelulaTabela}" Text="180,00"/>
                                    <Border Grid.Column="8" Width="45" Height="20" Background="#FDE8E8" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Atrasado" Foreground="#D92D20" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BotaoEditar}" Content="✎" ToolTip="Editar"/>
                                        <Button Style="{StaticResource BotaoExcluir}" Content="🗑" Margin="5,0,0,0" ToolTip="Excluir"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Calendário -->
                <Popup x:Name="PopupPeriodo"
                       Placement="MousePoint"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border x:Name="BorderPeriodo"
                            Background="#FFFFFF"
                            BorderBrush="#DCE3EC"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Width="230">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="206"/>
                                <ColumnDefinition x:Name="ColunaCalendario" Width="0"/>
                            </Grid.ColumnDefinitions>

                            <!-- Seleção do período -->
                            <StackPanel Grid.Column="0" Width="185">
                                <TextBlock Text="Selecionar período"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           Margin="0,0,0,10"/>
                                <!-- Data inicial -->
                                <TextBlock Text="Data inicial"
                                           FontSize="10"
                                           Foreground="#64748B"
                                           Margin="0,0,0,4"/>
                                <Grid Height="32">
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                    <TextBlock x:Name="TextoDataInicial"
                                               Text="Selecione uma data"
                                               Margin="9,0,36,0"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource BotaoCalendarioInterno}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="&#xE787;"
                                            Click="BotaoDataInicial_Click"
                                            ToolTip="Selecionar data inicial"/>
                                </Grid>

                                <!-- Data final -->
                                <TextBlock Text="Data final"
                                           FontSize="10"
                                           Foreground="#64748B"
                                           Margin="0,10,0,4"/>
                                <Grid Height="32">
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                    <TextBlock x:Name="TextoDataFinal"
                                               Text="Selecione uma data"
                                               Margin="9,0,36,0"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource BotaoCalendarioInterno}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="&#xE787;"
                                            Click="BotaoDataFinal_Click"
                                            ToolTip="Selecionar data final"/>
                                </Grid>
                                <Button Style="{StaticResource BotaoAcao}"
                                        Height="32"
                                        Margin="0,12,0,0"
                                        Content="Aplicar período"
                                        Click="AplicarPeriodo_Click"/>
                            </StackPanel>

                            <!-- Calendário ao lado do período -->
                            <Calendar x:Name="CalendarioPeriodo"
                                      Grid.Column="1"
                                      Width="190"
                                      Margin="12,18,0,0"
                                      SelectedDatesChanged="CalendarioPeriodo_SelectedDatesChanged"
                                      IsTodayHighlighted="True"
                                      Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</Window>