<Window x:Class="StrinGray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaFit - Sistema de Gestão"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#FAFBFC">

    <Window.Resources>

        <!-- Botão do menu lateral -->
        <Style x:Key="MenuLateralButton" TargetType="Button">
            <Setter Property="Height" Value="37"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="Transparent"
                                        CornerRadius="2"/>

                                <ContentPresenter Grid.Column="1" Margin="8,0,6,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" 
                                        Property="Background" 
                                        Value="#F5F9FF"/>
                                <Setter TargetName="Borda"
                                        Property="BorderBrush"
                                        Value="#C7D8F2"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda"
                                        Property="Background"
                                        Value="#EAF2FF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borda"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão lateral selecionado -->
        <Style x:Key="MenuLateralButtonSelecionado"
               TargetType="Button"
               BasedOn="{StaticResource MenuLateralButton}">

            <Setter Property="Background" Value="#EAF2FF"/>
            <Setter Property="BorderBrush" Value="#B9D0F2"/>
            <Setter Property="Foreground" Value="#1956C4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#1956C4" CornerRadius="2"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,6,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de ação principal -->
        <Style x:Key="BotaoAcao" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#1956C4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#1649A8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#123D8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão secundário -->
        <Style x:Key="BotaoSecundario" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1956C4"/>
            <Setter Property="BorderBrush" Value="#B9D0F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#F5F9FF"/>
                                <Setter TargetName="Borda" Property="BorderBrush" Value="#9DBBE8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#EAF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão limpar -->
        <Style x:Key="BotaoLimpar" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#FEF2F2"/>
                                <Setter TargetName="Borda" Property="BorderBrush" Value="#FCA5A5"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Campo de texto -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- Item do seletor -->
        <Style x:Key="ComboFiltroItem" TargetType="ComboBoxItem">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Borda"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="3,2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#F5F9FF"/>
                                <Setter Property="Foreground" Value="#1956C4"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#EAF2FF"/>
                                <Setter Property="Foreground" Value="#1956C4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Campo de seleção -->
        <Style x:Key="ComboFiltro" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboFiltroItem}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Borda"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <ContentPresenter Margin="9,0,30,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <TextBlock Text="⏷"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,1"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       IsHitTestVisible="False"/>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Focusable="False"
                                          OverridesDefaultStyle="True"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="#9DBBE8"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="#6F9FDF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borda" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de calendário interno -->
        <Style x:Key="BotaoCalendarioInterno" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#F5F9FF"/>
                                <Setter Property="Foreground" Value="#1956C4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#EAF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de calendário -->
        <Style x:Key="BotaoCalendario" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#F5F9FF"/>
                                <Setter Property="Foreground" Value="#1956C4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#EAF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de editar -->
        <Style x:Key="BotaoEditar" TargetType="Button">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1956C4"/>
            <Setter Property="BorderBrush" Value="#B9D0F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#F5F9FF"/>
                                <Setter TargetName="Borda" Property="BorderBrush" Value="#6F9FDF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#EAF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de excluir -->
        <Style x:Key="BotaoExcluir" TargetType="Button">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#F5B5B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="Borda" Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#FECACA"/>
                                <Setter Property="Foreground" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha da tabela -->
        <Style x:Key="CelulaTabela" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <SolidColorBrush x:Key="TextoPeriodoSelecionado" Color="#374151"/>

    </Window.Resources>

    <!-- Estrutura principal -->
    <Grid Background="#FAFBFC">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="230"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Grid Grid.Column="0" Background="#FFFFFF">

            <!-- Linha divisória -->
            <Border Width="1"
                    Background="#E5E7EB"
                    HorizontalAlignment="Right"
                    Panel.ZIndex="10"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="AquaFit"
                               FontFamily="Segoe UI"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1956C4"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="ESCOLA DE NATAÇÃO"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#5B7DBD"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Menu lateral -->
                <StackPanel Grid.Row="1" Margin="10,0,10,0">
                    <Button x:Name="BotaoDashboard" Style="{StaticResource MenuLateralButtonSelecionado}" Content="Dashboard" Tag="Dashboard" Click="Menu_Click"/>
                    <Button x:Name="BotaoAlunos" Style="{StaticResource MenuLateralButton}" Content="Alunos" Tag="Alunos" Click="Menu_Click"/>
                    <Button x:Name="BotaoProfessores" Style="{StaticResource MenuLateralButton}" Content="Professores" Tag="Professores" Click="Menu_Click"/>
                    <Button x:Name="BotaoTurmas" Style="{StaticResource MenuLateralButton}" Content="Turmas" Tag="Turmas" Click="Menu_Click"/>
                    <Button x:Name="BotaoHorarios" Style="{StaticResource MenuLateralButton}" Content="Horários" Tag="Horários" Click="Menu_Click"/>
                    <Button x:Name="BotaoMatriculas" Style="{StaticResource MenuLateralButton}" Content="Matrículas" Tag="Matrículas" Click="Menu_Click"/>
                    <Button x:Name="BotaoPagamentos" Style="{StaticResource MenuLateralButton}" Content="Pagamentos" Tag="Pagamentos" Click="Menu_Click"/>
                    <Button x:Name="BotaoPresenca" Style="{StaticResource MenuLateralButton}" Content="Presença" Tag="Presença" Click="Menu_Click"/>
                    <Button x:Name="BotaoRelatorios" Style="{StaticResource MenuLateralButton}" Content="Relatórios" Tag="Relatórios" Click="Menu_Click"/>
                    <Button x:Name="BotaoConfiguracoes" Style="{StaticResource MenuLateralButton}" Content="Configurações" Tag="Configurações" Click="Menu_Click"/>
                </StackPanel>

                <!-- Sair -->
                <Button Grid.Row="2"
                        Style="{StaticResource MenuLateralButton}"
                        Margin="10,0,10,12"
                        Content="Sair"
                        Click="BotaoSair_Click"/>
            </Grid>
        </Grid>

        <!-- Área Principal -->
        <Grid Grid.Column="1" Background="#FAFBFC">

            <!-- Dashboard -->
            <Grid x:Name="AreaDashboard" Visibility="Visible"/>

            <!-- Alunos -->
            <Grid x:Name="AreaAlunos" Visibility="Collapsed"/>

            <!-- Professores -->
            <Grid x:Name="AreaProfessores" Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Grid.Row="0" Margin="20,0,12,0">
                    <TextBlock Text="Professores"
                               FontFamily="Segoe UI"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="12,0,12,12"
                        Padding="14"
                        Background="#FFFFFF"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        CornerRadius="4">   
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.35*"/>
                            <ColumnDefinition Width="2.35*"/>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="64"/>
                        </Grid.RowDefinitions>

                        <!-- Nome -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Nome:"
                                       FontSize="11"
                                       Foreground="#374151"
                                       Margin="0,0,0,5"/>
                            <Grid Height="32">
                                <TextBox x:Name="CampoNome"
                                         Style="{StaticResource CampoTexto}"
                                         TextChanged="CampoAluno_TextChanged"/>
                                <TextBlock x:Name="TextoNome"
                                           Text="Digite o nome"
                                           Margin="9,0,36,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#94A3B8"/>
                            </Grid>
                        </StackPanel>

                        <!-- CPF -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="CPF:"
                                       FontSize="11"
                                       Foreground="#374151"
                                       Margin="0,0,0,5"/>
                            <Grid Height="32">
                                <TextBox x:Name="CampoCPF"
                                         Style="{StaticResource CampoTexto}"
                                         TextChanged="CampoAluno_TextChanged"/>
                                <TextBlock x:Name="TextoCPFPlaceholder"
                                           Text="Digite o CPF"
                                           Margin="9,0,9,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>

                        <!-- Turma -->
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Turma:"
                                       FontSize="11"
                                       Foreground="#374151"
                                       Margin="0,0,0,5"/>
                            <ComboBox Style="{StaticResource ComboFiltro}" SelectedIndex="0">
                                <ComboBoxItem Content="Todas"/>
                                <ComboBoxItem Content="Hidroginástica"/>
                                <ComboBoxItem Content="Natação Iniciante"/>
                                <ComboBoxItem Content="Natação Intermediário"/>
                                <ComboBoxItem Content="Natação Avançado"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="Status:"
                                       FontSize="11"
                                       Foreground="#374151"
                                       Margin="0,0,0,5"/>
                            <ComboBox Style="{StaticResource ComboFiltro}" SelectedIndex="0">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="Pago"/>
                                <ComboBoxItem Content="Pendente"/>
                                <ComboBoxItem Content="Atrasado"/>
                            </ComboBox>
                        </StackPanel>

